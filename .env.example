# Banco (no Render, use a Internal Database URL do PostgreSQL)
DATABASE_URL=postgresql://usuario:senha@host/banco
SECRET_KEY=troque-por-uma-chave-grande-e-aleatoria
COOKIE_SECURE=true

# Administrador inicial. ADMIN_LOGIN deve ser um e-mail válido.
ADMIN_NAME=Administrador
ADMIN_LOGIN=admin@escola.edu.br
ADMIN_PASSWORD=troque-esta-senha

# Firebase Web SDK (Project settings > General > Your apps > Web app)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Firebase Admin SDK (Project settings > Service accounts > Generate new private key)
# Opção A: JSON inteiro em uma única variável (também aceita base64 do JSON)
FIREBASE_SERVICE_ACCOUNT_JSON=
# Opção B: campos separados. Em FIREBASE_PRIVATE_KEY, preserve as quebras como \\n.
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@seu-projeto.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=
FIREBASE_CLIENT_CERT_URL=
