APP_NAME=EDUSCANNER
ENV=development
SECRET_KEY=troque-esta-chave-em-producao
DATABASE_URL=sqlite:///./data/eduscanner.db
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
# Domínios com permissão para chamar a API entre origens (CORS),
# separados por vírgula. Deixe vazio se o EDUSCANNER só for acessado
# pelo próprio navegador na mesma origem (comportamento padrão e mais
# seguro). Exemplo: ALLOWED_ORIGINS=https://app.minhaescola.com
ALLOWED_ORIGINS=
